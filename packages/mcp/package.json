{
	"name": "@mariozechner/pi-mcp",
	"version": "0.62.0",
	"description": "MCP client for connecting to external MCP servers",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
