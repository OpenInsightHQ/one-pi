# HTTP API server
PI_HTTP_PORT=3000
PI_API_KEY=your-secure-api-key
SKILL_REPO_DIR=/app/skill-repo

# MongoDB — shared with the arp (LibreChat) system.
# Required for authorized skills (MongoDB-backed) and ACL permission checks.
# When unset, pi runs in personal-skills-only mode (no ACL).
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
# Optional MongoDB connection pool tuning (all optional):
# MONGO_MAX_POOL_SIZE=
# MONGO_MIN_POOL_SIZE=
# MONGO_MAX_CONNECTING=
# MONGO_MAX_IDLE_TIME_MS=
# MONGO_WAIT_QUEUE_TIMEOUT_MS=
# MONGO_AUTO_INDEX=
# MONGO_AUTO_CREATE=

# Default provider/model for the HTTP server (provider must be configured below)
PI_PROVIDER=opencode-go
PI_MODEL=minimax-m2.7

# Provider API keys (set the ones you use)
OPENCODE_API_KEY=your-opencode-api-key
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_API_KEY=xxxxx
